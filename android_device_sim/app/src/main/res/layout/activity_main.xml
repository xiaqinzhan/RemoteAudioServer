<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模拟设备 · 采集端"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- 连接配置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="服务器地址"
                android:textColor="@color/sub"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"
                android:hint="https://xxx.dev.coze.site 或 http://192.168.x.x:8000"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/weak"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="设备 ID"
                android:textColor="@color/sub"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"
                android:hint="dev-android-001"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/weak"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_accent"
                android:text="连接服务器"
                android:textColor="#06222B"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <View
                android:id="@+id/dot_status"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_offline" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="未连接"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/text_stream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未推流"
                android:textColor="@color/weak"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 音源选择 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="音源（start_stream 时推送）"
                android:textColor="@color/sub"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/group_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/src_tone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent"
                    android:checked="true"
                    android:text="合成蜂鸣"
                    android:textColor="@color/text" />

                <RadioButton
                    android:id="@+id/src_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:buttonTint="@color/accent"
                    android:text="手机麦克风"
                    android:textColor="@color/text" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="蜂鸣频率(Hz)"
                android:textColor="@color/sub"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_freq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:inputType="number"
                android:text="660"
                android:textColor="@color/text"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 日志 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行日志"
                android:textColor="@color/sub"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:text="等待连接…"
                android:textColor="@color/sub"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
