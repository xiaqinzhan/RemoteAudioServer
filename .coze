[project]

[dev]
build = ["pip3", "install", "-r", "requirements.txt"]
run = ["sh", "-c", "python3 -m uvicorn server.main:app --host 0.0.0.0 --port ${DEPLOY_RUN_PORT}"]

[deploy]
build = ["bash", "-c", "pip3 install -r requirements.txt"]
run = ["sh", "-c", "python3 -m uvicorn server.main:app --host 0.0.0.0 --port ${DEPLOY_RUN_PORT}"]